        "method": "POST",
        "url": "https://richgcollection.com/api/bot/message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from, profileName: $json.profileName, text: $json.text, replyId: $json.replyId }) }}",
        "options": {
          "timeout": 25000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          }
        }
      },
      "id": "f66672df-4f55-46a7-a164-f4ab25bc11fb",
      "name": "Ask website bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "RichG Bot API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "jsCode": "// One item per WhatsApp message, in order, ready for \"Send WhatsApp\".\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const reply = items[i].json;\n  const inbound = $('Parse messages').itemMatching(i).json;\n  for (const message of reply.messages ?? []) {\n    out.push({ json: { phoneNumberId: inbound.phoneNumberId, to: reply.to ?? inbound.from, message } });\n  }\n}\nreturn out;"
      },
      "id": "a9b10750-8c47-4e54-aee5-be6308aa5a33",
      "name": "Split messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
