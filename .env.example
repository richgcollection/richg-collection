# Database (Postgres — pooled connection for the app, direct/session connection for migrations)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Storage (Vercel Blob — create via Vercel dashboard: Storage tab -> Create -> Blob)
BLOB_READ_WRITE_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM="Rich G Collection <orders@richgcollection.com>"
CONTACT_FORM_RECIPIENT=

# Seed / initial admin
SEED_ADMIN_EMAIL="admin@richgcollection.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="KES"

# Meta (Facebook/Instagram) Pixel — see setup guide from Claude for how to get this
NEXT_PUBLIC_META_PIXEL_ID=
