# Database (Postgres — pooled connection for the app, direct/session connection for migrations)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Storage (Vercel Blob — create via Vercel dashboard: Storage tab -> Create -> Blob)
BLOB_READ_WRITE_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM="Rich G Collection <orders@richgcollection.com>"
CONTACT_FORM_RECIPIENT=

# Seed / initial admin
SEED_ADMIN_EMAIL="admin@richgcollection.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="KES"
# KES per 1 USD, used to convert customer value to dollars in the Meta Ads CSV export (defaults to 129)
KES_PER_USD=129

# Meta (Facebook/Instagram) Pixel — see setup guide from Claude for how to get this
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side Purchase events)
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager > Test events code, for testing server events
META_CAPI_TEST_EVENT_CODE=

# WhatsApp sales bot (n8n). BOT_API_KEY: a long random string shared with n8n (openssl rand -hex 32).
BOT_API_KEY=
# n8n webhook that sends "payment received" WhatsApp messages (Production URL of the "Order paid" webhook node)
N8N_WHATSAPP_NOTIFY_URL=
# Minutes an unpaid order holds its stock (default 30)
BOT_RESERVATION_MINUTES=30
# Optional: what the bot says when a customer asks for a person
BOT_SUPPORT_TEXT=

# Google Sheet stock tracker sync (integrations/google-sheets). Shared with the
# sheet's Apps Script as SYNC_SECRET. At least 32 characters: openssl rand -hex 32
SHEETS_SYNC_SECRET=
