      "id": "c71366a7-bdfd-4908-9363-2730cc671308",
      "name": "WhatsApp inbound (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "aac0fdd2-4b5b-4d2d-8a58-539997330e82"
