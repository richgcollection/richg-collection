    {
      "parameters": {
        "jsCode": "// Turns Meta's webhook payload into one item per customer message.\n// Delivery/read receipts (value.statuses) are ignored.\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  for (const entry of body.entry ?? []) {\n    for (const change of entry.changes ?? []) {\n      const value = change.value ?? {};\n      const phoneNumberId = value.metadata?.phone_number_id;\n      const names = Object.fromEntries((value.contacts ?? []).map(c => [c.wa_id, c.profile?.name]));\n      for (const m of value.messages ?? []) {\n        let text = null, replyId = null;\n        if (m.type === 'text') text = m.text?.body ?? null;\n        else if (m.type === 'interactive') {\n          const r = m.interactive?.button_reply ?? m.interactive?.list_reply;\n          replyId = r?.id ?? null; text = r?.title ?? null;\n        } else if (m.type === 'button') { replyId = m.button?.payload ?? null; text = m.button?.text ?? null; }\n        out.push({ json: { from: m.from, profileName: names[m.from] ?? null, text, replyId, messageId: m.id, phoneNumberId } });\n      }\n    }\n  }\n}\nreturn out;"
      },
      "id": "04206485-1062-4ff9-a9dc-63e44d63b6aa",
      "name": "Parse messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v24.0/{{ $json.phoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', status: 'read', message_id: $json.messageId }) }}",
        "options": {}
      },
      "id": "a3e04dc8-8522-46ce-a369-cf8b06de9b6b",
      "name": "Mark as read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
